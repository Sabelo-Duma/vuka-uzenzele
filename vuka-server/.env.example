# ------------------------------------------------------------------
# Vuka Uzenzele API — environment variables
# Copy to `.env` for local use, or set these in your host (Render → Environment).
# NEVER commit real secrets. This file documents every knob the server reads.
# ------------------------------------------------------------------

# Node environment. Set to "production" on your live host.
# In production the server REFUSES to start without VUKA_JWT_SECRET (below).
NODE_ENV=development

# Port the API listens on. Render sets this automatically.
PORT=3001

# REQUIRED IN PRODUCTION. A long, random secret used to sign login tokens.
# Generate one with:  openssl rand -hex 32
# On Render this is generated for you (render.yaml → generateValue: true).
VUKA_JWT_SECRET=

# REQUIRED IN PRODUCTION *if workers will save payout details*. Encrypts bank
# account numbers at rest (AES-256-GCM). Generate with: openssl rand -hex 32
# Without it in production the banking endpoints return 503 rather than store a
# payout target under a guessable key; the rest of the API is unaffected.
# WARNING: changing this key makes already-stored account numbers unreadable.
VUKA_ENCRYPTION_KEY=

# PERSISTENCE. Point at a Postgres database (e.g. Supabase, free tier) and all
# data — including real sign-ups — survives every deploy. Leave BLANK to use a
# local SQLite file (great for dev, but ephemeral on Render — demo only).
# Format (Supabase → Connection string → "Transaction" pooler, port 6543):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ------------------------------------------------------------------
# SMS delivery (sign-up codes, password resets, "you've been hired")
# ------------------------------------------------------------------
# console (default) → messages are only logged. Fine for dev; in production it
#                     means nothing is delivered.
# http              → POST {to, body} as JSON to VUKA_SMS_URL (most SA
#                     aggregators: Clickatell, BulkSMS, Panacea).
# twilio            → Twilio REST API.
VUKA_SMS_PROVIDER=console
VUKA_SMS_URL=
VUKA_SMS_AUTH=
VUKA_TWILIO_SID=
VUKA_TWILIO_TOKEN=
VUKA_TWILIO_FROM=

# PILOT ONLY, INSECURE. Returns one-time codes in the API response so sign-up
# and password reset work with no SMS contract in place. Anyone who knows a
# phone number could take over that account — never set this for real users.
# (In dev, with provider=console, codes are echoed anyway.)
VUKA_OTP_ECHO=

# Enables the ops routes that approve/reject ID verifications
# (GET/POST /api/admin/id-verifications*, sent as an x-admin-token header).
# Leave BLANK and those routes don't exist at all. Generate: openssl rand -hex 24
VUKA_ADMIN_TOKEN=

# Only needed if you host the front-end on a DIFFERENT origin than the API.
# Same-origin single-service deploys (the default) need nothing here.
# Comma-separated list of allowed origins.
VUKA_CORS_ORIGIN=

# Advanced overrides (usually leave unset):
# Path to the built front-end to serve (Docker sets this to /app/public).
# VUKA_STATIC=
# Custom SQLite file path (dev/tests only).
# VUKA_DB=
