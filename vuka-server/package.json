{
  "name": "vuka-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vuka Uzenzele API — Express + built-in SQLite + JWT auth.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/server.mjs",
    "dev": "node --experimental-sqlite --watch src/server.mjs",
    "seed": "node --experimental-sqlite src/seed.mjs",
    "vapid:keys": "node src/vapid.mjs",
    "backup": "node --experimental-sqlite scripts/backup.mjs",
    "restore": "node --experimental-sqlite scripts/backup.mjs restore",
    "test": "node --experimental-sqlite src/test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "pg": "^8.22.0"
  }
}
